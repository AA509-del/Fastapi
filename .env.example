# 复制为 .env 后填写真实值（.env 勿提交 Git）

# 智谱大模型（必填；与 ZHIPUAI_API_KEY 二选一即可）
ZHIPUAI_API_KEY=
# ZHIPU_API_KEY=

# 心知天气 Seniverse（不填则天气工具返回配置提示）
SENIVERSE_API_KEY=
# SENIVERSE_KEY=

# 预留，当前项目未使用 OpenAI 时可留空
OPENAI_API_KEY=

# LangGraph AsyncSqliteSaver 数据库路径（默认与现有一致）
DB_PATH=checkpointer.db

# 文档说明用默认端口；实际端口以 uvicorn --port 为准
PORT=8000

# 本机运行时的服务地址；Docker Compose 会覆盖这两个值
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/agentdb
REDIS_URL=redis://localhost:6379
